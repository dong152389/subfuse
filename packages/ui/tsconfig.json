{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@subfuse/core": ["../core/src/index.ts"],
      "@subfuse/core/*": ["../core/src/*"],
      "@subfuse/ui": ["./src/index.ts"],
      "@subfuse/ui/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
